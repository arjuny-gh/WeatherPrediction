---
// Decorative, low-contrast math/physics motifs. Purely visual.
---
<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden text-accent" aria-hidden="true">
  <svg class="absolute inset-0 size-full opacity-[0.07]" xmlns="http://www.w3.org/2000/svg">
    <defs><pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse"><path d="M48 0H0V48" fill="none" stroke="currentColor" stroke-width="1"/></pattern></defs>
    <rect width="100%" height="100%" fill="url(#grid)"/>
  </svg>
  <svg class="absolute -right-24 -top-24 size-[34rem] opacity-20" viewBox="0 0 400 400" fill="none" stroke="currentColor">
    <circle cx="200" cy="200" r="190" stroke-width=".8"/><circle cx="200" cy="200" r="130" stroke-width=".8"/><circle cx="200" cy="200" r="70" stroke-width=".8"/>
    <ellipse cx="200" cy="200" rx="190" ry="60" stroke-width=".8" transform="rotate(-25 200 200)"/>
    <circle cx="352" cy="140" r="5" fill="currentColor" stroke="none"/>
  </svg>
  <span class="absolute left-[8%] bottom-10 font-serif text-6xl opacity-[0.12] select-none">∫</span>
  <span class="absolute right-[12%] bottom-14 font-serif text-5xl opacity-[0.12] select-none">π</span>
  <span class="absolute left-[46%] top-10 font-serif text-5xl opacity-[0.1] select-none">∇</span>
</div>
