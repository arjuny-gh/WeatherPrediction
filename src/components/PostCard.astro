---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime, url } from '../lib/site';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const d = post.data;
---
<article class="py-6 border-b border-line last:border-0">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
    <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(post.body ?? '')} min read</span>
    {d.sample && <span class="tag">Sample</span>}
  </div>
  <h3 class="mt-1 font-serif text-2xl font-semibold"><a class="hover:text-accent" href={url(`/writing/${post.id}`)}>{d.title}</a></h3>
  <p class="mt-2 text-muted">{d.description}</p>
  {d.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">{d.tags.map((t) => <li><a class="tag hover:underline" href={url(`/writing/tags/${t}`)}>#{t}</a></li>)}</ul>
  )}
</article>
