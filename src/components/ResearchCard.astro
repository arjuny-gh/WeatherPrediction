---
import { render, type CollectionEntry } from 'astro:content';
import { FileText } from '@lucide/astro';
import Icons from './Icons.astro';
import { url } from '../lib/site';

interface Props { entry: CollectionEntry<'research'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const sections = [
  ['Abstract', d.abstract],
  ['Methodology', d.methodology],
  ['Results', d.results],
  ['Future work', d.future],
] as const;
---
<article class="card p-6 sm:p-8">
  <div class="flex flex-wrap gap-2 mb-3"><span class="tag">{d.category}</span><span class="tag">{d.status}</span></div>
  <h3 class="font-serif text-2xl font-semibold">{d.title}</h3>
  <p class="mt-3"><span class="text-sm font-semibold uppercase tracking-wide text-accent">Research question</span><br /><span class="text-lg">{d.question}</span></p>
  <dl class="mt-5 grid gap-4">
    {sections.map(([label, text]) => text && (
      <div><dt class="text-sm font-semibold uppercase tracking-wide text-muted">{label}</dt><dd class="mt-1">{text}</dd></div>
    ))}
  </dl>
  <div class="prose dark:prose-invert mt-4 empty:hidden"><Content /></div>
  <div class="mt-5 flex flex-wrap gap-4 text-sm font-medium">
    {d.github && <a class="inline-flex items-center gap-1.5 text-accent hover:underline" href={d.github} rel="noopener"><Icons name="github" class="size-4" /> Repository</a>}
    {d.paper && <a class="inline-flex items-center gap-1.5 text-accent hover:underline" href={d.paper.startsWith('http') ? d.paper : url(d.paper)}><FileText class="size-4" aria-hidden="true" /> Paper (PDF)</a>}
  </div>
</article>
