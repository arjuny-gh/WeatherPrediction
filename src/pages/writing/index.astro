---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { url } from '../../lib/site';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---
<BaseLayout title="Notes & Ideas" description="Math problems, physics concepts, programming tutorials and reflections by Arjun Yadav.">
  <PageHeader eyebrow="Writing" title="Notes & Ideas" intro="Math problems, physics concepts, research explorations, programming tutorials, book reflections, and lessons from projects." />
  <div class="container-x">
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mb-6" aria-label="Filter by tag">{tags.map((t) => <li><a class="tag hover:underline" href={url(`/writing/tags/${t}`)}>#{t}</a></li>)}</ul>
    )}
    {posts.length === 0 ? <EmptyState title="No posts yet" /> : years.map((y) => (
      <section>
        <h2 class="font-serif text-xl text-muted mt-6">{y}</h2>
        {posts.filter((p) => p.data.date.getUTCFullYear() === y).map((post) => <PostCard post={post} />)}
      </section>
    ))}
  </div>
</BaseLayout>
