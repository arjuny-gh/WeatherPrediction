---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import { url } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`Notes tagged ${tag}.`}>
  <PageHeader eyebrow="Tag" title={`#${tag}`} />
  <div class="container-x">
    <p class="mb-4"><a class="text-accent hover:underline" href={url('/writing')}>← All notes</a></p>
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
