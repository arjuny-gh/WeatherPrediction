---
import { Mail } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icons from '../components/Icons.astro';
import { site } from '../lib/site';
---
<BaseLayout title="Contact" description="Get in touch with Arjun Yadav about research, mentorship or collaboration.">
  <PageHeader eyebrow="Contact" title="Let's connect" intro="I'm happy to hear from professors, research mentors, fellow students, and STEM organizations — about research questions, collaboration, or anything I've written." />
  <div class="container-x grid gap-6 md:grid-cols-2">
    <div class="card p-6">
      <h2 class="font-serif text-xl font-semibold">Reach me</h2>
      <ul class="mt-4 space-y-3">
        {site.github && <li><a class="inline-flex items-center gap-2 text-accent hover:underline" href={site.github} rel="noopener"><Icons name="github" class="size-5" /> GitHub</a></li>}
        {site.linkedin && <li><a class="inline-flex items-center gap-2 text-accent hover:underline" href={site.linkedin} rel="noopener"><Icons name="linkedin" class="size-5" /> LinkedIn</a></li>}
        {site.email
          ? <li><a class="inline-flex items-center gap-2 text-accent hover:underline" href={`mailto:${site.email}`}><Mail class="size-5" aria-hidden="true" /> {site.email}</a></li>
          : <li class="text-muted">A public email address will be added here once approved. For now, GitHub is the best way to reach me.</li>}
      </ul>
    </div>
    <div class="card p-6">
      <h2 class="font-serif text-xl font-semibold">If you're writing to me</h2>
      <ul class="mt-4 list-disc pl-5 space-y-2 text-muted">
        <li>Tell me briefly who you are and what you have in mind.</li>
        <li>For mentorship or research, a specific question helps me respond well.</li>
        <li>I'm a student, so replies may take a few days.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
