---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';
---
<BaseLayout title="Page not found" noindex>
  <section class="container-x py-28 text-center">
    <p class="font-serif text-8xl text-accent">404</p>
    <h1 class="mt-4 font-serif text-3xl font-semibold">This point isn't on the graph.</h1>
    <p class="mt-3 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a href={url('/')} class="btn btn-primary mt-8">Back home</a>
  </section>
</BaseLayout>
